{
  "name": "@snappedcut/canvas-expo",
  "version": "0.1.1",
  "description": "The Snapped Cut video editor in an Expo app: the canvas plus the pickers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snappedcut-dev/canvas-expo.git"
  },
  "homepage": "https://snappedcut.com/docs",
  "bugs": "https://github.com/snappedcut-dev/canvas-expo/issues",
  "keywords": [
    "snappedcut",
    "expo",
    "react-native",
    "video-editor",
    "webview",
    "ios",
    "android"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@snappedcut/canvas-react-native": "^0.1.0"
  },
  "peerDependencies": {
    "expo": ">=51",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-image-picker": "*",
    "expo-media-library": "*",
    "expo-sharing": "*",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "expo-document-picker": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-media-library": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
